# Frontend Environment Variables for Production

# Backend API URL (set this to your Render backend URL)
NEXT_PUBLIC_API_URL=https://batscripted-backend.onrender.com

# Socket.io Server URL
NEXT_PUBLIC_SOCKET_URL=https://batscripted-backend.onrender.com

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# Environment
NEXT_PUBLIC_ENV=production
